{
  "manifest_version": 2,
  "name": "Here for Instagram",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "cookies",
    "contextualIdentities",
    "webRequest",
    "webRequestBlocking",
    "*://*.instagram.com/*"
  ],
  "description": "Splits Instagram's Home into three separate views: suggestions (Algo), Following and Favourites, hides posts you've seen, and shows Reels as a grid.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "page_action": {
    "default_icon": "icon.svg",
    "default_title": "Instagram accounts",
    "default_popup": "popup.html",
    "show_matches": [
      "*://www.instagram.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "stories.js",
        "accounts.js",
        "content.js",
        "reels.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "here-for-instagram@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
