{
  "manifest_version": 2,
  "name": "Sinstagram",
  "version": "0.15.2",
  "permissions": [
    "storage"
  ],
  "description": "Splits Instagram's Home into three separate views: suggestions (Algo), Following and Favourites, and shows Reels as a grid.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "stories.js",
        "content.js",
        "reels.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sinstagram@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
