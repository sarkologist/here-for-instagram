{
  "manifest_version": 2,
  "name": "Here for Instagram",
  "version": "2.0.0",
  "permissions": [
    "storage"
  ],
  "description": "Splits Instagram's Home into Following, Favourites and suggestions (Algo), hides posts you've seen, and shows Home, Explore, Reels and profiles as a grid with a player.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "stories.js",
        "content.js",
        "feed.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "here-for-instagram@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
