{
  "manifest_version": 2,
  "name": "Here for Instagram",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "description": "Splits Instagram's Home into three separate views: suggestions (Algo), Following and Favourites, shows Reels as a grid, and adds download buttons.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "stories.js",
        "content.js",
        "reels.js",
        "downloads.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "here-for-instagram@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
